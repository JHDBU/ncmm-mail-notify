# Install as /etc/ncmm-mail.env (mode 0640). Secrets stay out of the repo.
# Environment variables override config.yaml.
NCMM_MAIL_SENDER_NAME=云村邮件通
NCMM_MAIL_FROM=
NCMM_MAIL_TO=
NCMM_MAIL_SMTP_HOST=smtp.qq.com
NCMM_MAIL_SMTP_PORT=465
NCMM_MAIL_SMTP_SECURITY=ssl
NCMM_MAIL_SMTP_USER=
NCMM_MAIL_SMTP_PASSWORD=
NCMM_MAIL_SUBJECT_PREFIX=[ncmm]
NCMM_MAIL_WEBHOOK_TOKEN=
