# Optional: expose the built-in web console at https://<your-domain>/mail/
# Paste this block INTO the existing 443 server block, BEFORE "location /".
# Requires an htpasswd file (see README). Only the loopback service is proxied.

    location ^~ /mail/ {
        auth_basic "ncmm mail console";
        auth_basic_user_file /etc/nginx/.ncmm-mail-htpasswd;

        proxy_pass http://127.0.0.1:8787/;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:8787;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
